# Copy to `.env` (repository root or backend/) and adjust. `.env` is git-ignored.
# Every value is optional: with no .env the backend runs fully offline and deterministic.

# ---------------------------------------------------------------- LLM (optional)
# The LLM only rephrases the executive narrative from REDACTED, aggregated findings.
# It never decides the verdict, the score or the remediation plan.
#   none               -> deterministic template (default, no network)
#   openai_compatible  -> any OpenAI-style /chat/completions endpoint
#   anthropic          -> Anthropic Messages API
LLM_PROVIDER=none
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_S=30
LLM_MAX_TOKENS=1200

# Examples (uncomment one block):
# --- Anthropic
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5-5
# LLM_API_KEY=<your key>
# --- OpenAI or compatible gateway
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=<model name>
# LLM_API_KEY=<your key>
# --- Local model via Ollama (no key needed)
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# ---------------------------------------------------------------- server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
QIRO_DEFAULT_SEED=2026
MAX_UPLOAD_MB=25

# ---------------------------------------------------------------- live data (optional)
# Enables the openFDA device-recall tool (outbound HTTPS to api.fda.gov).
ONLINE_TOOLS_ENABLED=false
# Folder with user-downloaded CICIoMT2024 CSV files for the simulator's "replay" data source.
REPLAY_DATA_DIR=
