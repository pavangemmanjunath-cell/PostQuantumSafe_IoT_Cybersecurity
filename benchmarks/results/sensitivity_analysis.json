  "method": {
    "scenarios": "The ten built-in synthetic scenarios (safeguard_pq/data/scenarios.json), each run once through the full pipeline (llm_report=False, fixed seed) to obtain the baseline findings, PQ score, verdict, environment status, pillar scores and QIRO plan.",
    "S1_category_weights": "One-at-a-time: each of the six category weights is scaled by 0.8 and 1.2 and all six are renormalised to sum to 1; the score is recomputed from the baseline findings.",
    "S2_severity_points": "All severity points (critical 100, high 75, medium 50, low 25) scaled by 0.8 and 1.2 at once; the fixed 75-point 'no PQ algorithm in use' posture value is not a severity and is not scaled.",
    "S3_pillar_deductions": "All per-severity pillar deductions scaled by 0.8 and 1.2 at once; pillar scores recomputed from the baseline findings. Deductions do not enter the PQ score, so the score metrics are reported only as a check.",
    "S4_lifetime_threshold": "The data-lifetime threshold of the critical long_lifetime_classical_crypto rule (default 10 years) set to 5, 10, 15 and 20 years via assumptions.lifetime_threshold_years and the full pipeline re-run, so findings, score, status and plan can all change.",
    "S5_optimizer_pillar_weights": "QIRO's TIPPSS pillar weights scaled by 0.8 and 1.2 at once (module constant patched for the run and restored); the optimizer re-run on the baseline findings with the scenario's budget / downtime constraints and the same seed.",
    "metrics": {
      "verdict_change_share": "share of the ten scenarios whose 4-level PQ verdict differs from baseline",
      "status_change_share": "share whose SAFE / AT_RISK / UNSAFE environment status differs from baseline",
      "mean_abs_delta_score, max_abs_delta_score": "mean and maximum |perturbed - baseline| PQ risk score (0-100 integer scale)",
      "spearman_rank_correlation": "Spearman rank correlation (average ranks for ties) between the baseline and perturbed PQ-score rankings of the ten scenarios; null when undefined",
      "mean_plan_jaccard": "mean Jaccard similarity of the selected-action sets, matched by finding; only where plans were recomputed (S4, S5), else null. Findings are renumbered when the finding set changes (S4), so actions are matched by a stable finding signature (agent, type, device / detected value) rather than by the F-number.",
      "pillar_metrics (S3)": "mean and max |perturbed - baseline| pillar score over 6 pillars x 10 scenarios; the share of scenarios whose reported weakest pillar changes (argmin, ties broken in TIPPSS order) and the share where that change is strict (the baseline weakest pillar is no longer at the minimum). Under uniform scaling, non-strict changes arise only from the 0 floor creating ties."
    }
  },
  "caveat": "Ten synthetic hand-written scenarios; weights are design choices, not calibrated on incident data."
